{
  "name": "@pharos-ds/theme-y2k",
  "version": "1.0.1",
  "displayName": "Y2K Theme",
  "private": true,
  "description": "Hot pinks, lime greens, and Poppins. Bubbly, playful, and unmistakably retro.",
  "author": "Caio Silvestre",
  "license": "MIT",
  "homepage": "https://github.com/Lex-Energia/alexandria-ds#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lex-Energia/alexandria-ds.git",
    "directory": "packages/themes/y2k"
  },
  "bugs": {
    "url": "https://github.com/Lex-Energia/alexandria-ds/issues"
  },
  "keywords": [
    "pharos",
    "theme",
    "design-system",
    "lucide",
    "design-tokens"
  ],
  "sideEffects": false,
  "main": "./dist/source.js",
  "types": "./dist/source.d.ts",
  "exports": {
    ".": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.mjs",
      "require": "./dist/source.js"
    },
    "./built": {
      "types": "./dist/y2k.d.ts",
      "import": "./dist/y2k.js",
      "require": "./dist/y2k.js"
    },
    "./theme.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pharos theme build src/y2kTheme.ts -o dist/theme.css && tsup && tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "lucide-react": "^1.26.0"
  },
  "peerDependencies": {
    "@pharos-ds/core": "1.0.2",
    "react": ">=19"
  },
  "devDependencies": {
    "@pharos-ds/cli": "1.0.2"
  },
  "module": "./dist/source.mjs"
}
