{
  "name": "@pharos-ds/theme-pharos",
  "version": "1.0.8",
  "displayName": "Pharos Theme",
  "private": false,
  "description": "Official Pharos theme for the Alexandria brand — the default theme for every Pharos app.",
  "author": "Caio Silvestre",
  "license": "MIT",
  "homepage": "https://github.com/Lex-Energia/alexandria-ds#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lex-Energia/alexandria-ds.git",
    "directory": "packages/themes/pharos"
  },
  "bugs": {
    "url": "https://github.com/Lex-Energia/alexandria-ds/issues"
  },
  "keywords": [
    "pharos",
    "theme",
    "design-system",
    "lucide",
    "design-tokens"
  ],
  "sideEffects": false,
  "main": "./dist/source.js",
  "types": "./dist/source.d.ts",
  "exports": {
    ".": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.mjs",
      "require": "./dist/source.js"
    },
    "./built": {
      "types": "./dist/pharos.d.ts",
      "import": "./dist/pharos.js",
      "require": "./dist/pharos.js"
    },
    "./theme.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/theme.css"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.mjs",
      "require": "./dist/brand.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "import": "./dist/logo.mjs",
      "require": "./dist/logo.js"
    },
    "./fonts.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/fonts.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:logos": "node scripts/build-logos.mjs",
    "build": "rm -rf dist && pharos theme build src/pharosTheme.ts -o dist/theme.css && cp src/fonts.css dist/fonts.css && tsup && tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "lucide-react": "^1.26.0"
  },
  "peerDependencies": {
    "@pharos-ds/core": "1.0.8",
    "react": ">=19"
  },
  "devDependencies": {
    "@pharos-ds/cli": "1.0.8"
  },
  "module": "./dist/source.mjs"
}
